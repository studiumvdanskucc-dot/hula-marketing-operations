# Optional team gate for a publicly reachable Streamlit app
APP_PASSWORD=replace-with-a-strong-team-password

# Shopify Dev Dashboard app (current client-credentials flow)
SHOPIFY_SHOP=your-store-subdomain
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_STOREFRONT_URL=https://thehula.com
SHOPIFY_MAX_PRODUCTS=750

# Legacy Shopify custom-app token, only if your existing app still uses one
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Apify pre-configured X scraper task
APIFY_TOKEN=
APIFY_X_TASK_ID=
APIFY_X_TASK_INPUT_JSON={}
APIFY_TIMEOUT_SECONDS=480
APIFY_X_MEMORY_MB=512
APIFY_X_LISTENING_MODE=topic_plan
APIFY_RESULTS_PER_QUERY=50
APIFY_EXPERT_RESULTS_PER_QUERY=35
APIFY_MAX_TOTAL_CHARGE_USD=0.25
X_LANGUAGE=en
X_PRIORITY_ACCOUNTS=WhoWhatWear,WhoWhatWearUK,Lyst
X_EXPERT_ACCOUNTS=VogueRunway,VogueBusiness,BoF,WGSN,HYPEBEAST,Highsnobiety,Fashionista_com,Dazed,i_D,BritishVogue,VogueHongKong,TatlerAsia,VestiaireCo,therealreal

# Aggregate Instagram hashtag comparison (uses the same Apify token)
INSTAGRAM_ENABLED=true
APIFY_INSTAGRAM_ACTOR_ID=apify~instagram-hashtag-analytics-scraper
INSTAGRAM_HASHTAG_MAX_TERMS=8
INSTAGRAM_MAX_TOTAL_CHARGE_USD=0.25

# Public commercial websites/reports (no API key required)
COMMERCIAL_SOURCES_ENABLED=true
COMMERCIAL_TIMEOUT_SECONDS=25
COMMERCIAL_MAX_WORKERS=4

# OpenRouter / Qwen
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=qwen/qwen3-vl-32b-instruct
OPENROUTER_TIMEOUT=180
OPENROUTER_SITE_URL=https://your-hula-app.streamlit.app/
OPENROUTER_APP_NAME=HULA Trend Intelligence

# Google Trends through SerpApi (free plan is sufficient for weekly HULA use)
SERPAPI_API_KEY=
SERPAPI_ENDPOINT=https://serpapi.com/search.json
SERPAPI_TIMEOUT_SECONDS=75
GOOGLE_TRENDS_GEO=WORLDWIDE
GOOGLE_TRENDS_TIMEFRAME=today 1-m
GOOGLE_TRENDS_DISCOVERY_TIMEFRAME=now 7-d
GOOGLE_TRENDS_CATEGORY=0
GOOGLE_TRENDS_ANCHOR_TERM=designer fashion
GOOGLE_TRENDS_RELATED_QUERIES=true
# auto = SerpApi; the manual CSV importer is the emergency fallback
GOOGLE_TRENDS_PROVIDER=auto
GOOGLE_TRENDS_MAX_TERMS=24
GOOGLE_TRENDS_MAX_DISCOVERY_SEEDS=2
GOOGLE_TRENDS_RELATED_VALIDATION_TERMS=4
GOOGLE_TRENDS_CACHE_HOURS=24
GOOGLE_TRENDS_STALE_CACHE_DAYS=3
GOOGLE_TRENDS_CONNECT_TIMEOUT_SECONDS=10
GOOGLE_TRENDS_READ_TIMEOUT_SECONDS=35

# Optional comma-separated watchlist; defaults are used when blank
FASHION_TERMS=
SNAPSHOT_PATH=data/latest_snapshot.json

# Durable aggregate history. Use the project root URL without /rest/v1/.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SNAPSHOT_TABLE=hula_trend_snapshots
SUPABASE_BLOG_TABLE=hula_blog_drafts

# Grounded Wednesday editorial research
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=180
GEMINI_GROUNDING_ENABLED=true
