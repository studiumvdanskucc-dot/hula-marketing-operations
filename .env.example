# Optional team gate for a publicly reachable Streamlit app
APP_PASSWORD=replace-with-a-strong-team-password

# Shopify Dev Dashboard app (current client-credentials flow)
SHOPIFY_SHOP=your-store-subdomain
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_STOREFRONT_URL=https://thehula.com
SHOPIFY_MAX_PRODUCTS=750

# Legacy Shopify custom-app token, only if your existing app still uses one
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Apify pre-configured X scraper task
APIFY_TOKEN=
APIFY_X_TASK_ID=
APIFY_X_TASK_INPUT_JSON={}
APIFY_TIMEOUT_SECONDS=480
APIFY_X_MEMORY_MB=512
APIFY_X_LISTENING_MODE=topic_plan
APIFY_RESULTS_PER_QUERY=50
APIFY_EXPERT_RESULTS_PER_QUERY=35
APIFY_MAX_TOTAL_CHARGE_USD=0.25
X_LANGUAGE=en
X_PRIORITY_ACCOUNTS=WhoWhatWear,WhoWhatWearUK,Lyst
X_EXPERT_ACCOUNTS=VogueRunway,VogueBusiness,BoF,WGSN,HYPEBEAST,Highsnobiety,Fashionista_com,Dazed,i_D,BritishVogue,VogueHongKong,TatlerAsia,VestiaireCo,therealreal

# Aggregate Instagram hashtag comparison (uses the same Apify token)
INSTAGRAM_ENABLED=true
APIFY_INSTAGRAM_ACTOR_ID=apify~instagram-hashtag-analytics-scraper
INSTAGRAM_HASHTAG_MAX_TERMS=8
INSTAGRAM_MAX_TOTAL_CHARGE_USD=0.25

# Public commercial websites/reports (no API key required)
COMMERCIAL_SOURCES_ENABLED=true
COMMERCIAL_TIMEOUT_SECONDS=25
COMMERCIAL_MAX_WORKERS=4

# Recommended mixed model path. Luna filters, Terra merges aliases, Sol writes
# the final evidence-led synthesis/blog; Python calculates every score.
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/responses
OPENAI_LUNA_MODEL=gpt-5.6-luna
OPENAI_TERRA_MODEL=gpt-5.6-terra
OPENAI_SOL_MODEL=gpt-5.6-sol
OPENAI_TIMEOUT_SECONDS=180

# Optional fallback when OPENAI_API_KEY is absent
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=qwen/qwen3-vl-32b-instruct
OPENROUTER_TIMEOUT=180
OPENROUTER_SITE_URL=https://your-hula-app.streamlit.app/
OPENROUTER_APP_NAME=HULA Trend Intelligence

# Google Trends through SerpApi (free plan is sufficient for weekly HULA use)
SERPAPI_API_KEY=
SERPAPI_ENDPOINT=https://serpapi.com/search.json
SERPAPI_TIMEOUT_SECONDS=75
GOOGLE_TRENDS_GEO=WORLDWIDE
GOOGLE_TRENDS_TIMEFRAME=today 3-m
GOOGLE_TRENDS_DISCOVERY_TIMEFRAME=now 7-d
GOOGLE_TRENDS_CATEGORY=0
GOOGLE_TRENDS_ANCHOR_TERM=designer fashion
GOOGLE_TRENDS_RELATED_QUERIES=true
# auto = SerpApi; the manual CSV importer is the emergency fallback
GOOGLE_TRENDS_PROVIDER=auto
GOOGLE_TRENDS_MAX_TERMS=24
GOOGLE_TRENDS_MAX_DISCOVERY_SEEDS=2
GOOGLE_TRENDS_RELATED_VALIDATION_TERMS=4
GOOGLE_TRENDS_CACHE_HOURS=24
GOOGLE_TRENDS_STALE_CACHE_DAYS=3
GOOGLE_TRENDS_CONNECT_TIMEOUT_SECONDS=10
GOOGLE_TRENDS_READ_TIMEOUT_SECONDS=35

# Optional comma-separated watchlist; defaults are used when blank
FASHION_TERMS=
SNAPSHOT_PATH=data/latest_snapshot.json

# Durable aggregate history. Use the project root URL without /rest/v1/.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SNAPSHOT_TABLE=hula_trend_snapshots
SUPABASE_BLOG_TABLE=hula_blog_drafts

# Optional evidence-locked writing fallback (live grounding is deliberately off)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=180
GEMINI_GROUNDING_ENABLED=false

# =============================================================================
# HULA MARKETING OPERATIONS — second Streamlit entry point
# Start with: streamlit run apps/marketing_operations.py --server.port 8502
# =============================================================================

# Application and identity. DEMO_MODE=true starts safely without any live data.
APP_ENV=development
MARKETING_APP_NAME=HULA Marketing Operations
APP_TIMEZONE=Asia/Hong_Kong
APP_CURRENCY=HKD
DEMO_MODE=true
DEMO_USER_NAME=Tereza (Demo Operator)
DEMO_DEFAULT_ROLE=Marketing Operator
MARKETING_DATABASE_PATH=data/marketing_operations_demo.sqlite3
MARKETING_AUTH_ENABLED=false

# Supabase Auth / Postgres. ANON key is used only for user login/RLS requests.
# SERVICE_ROLE must be available only to a background worker, never browser code.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DATABASE_ENCRYPTION_KEY=

# Every external write is OFF in the first release.
ENABLE_SHOPIFY_WRITES=false
ENABLE_GOOGLE_ADS_WRITES=false
ENABLE_META_ADS_WRITES=false
ENABLE_KLAVIYO_WRITES=false
ENABLE_GBP_WRITES=false
ENABLE_MERCHANT_WRITES=false
ENABLE_AUTOMATIC_PUBLISHING=false
ENABLE_AUTOMATIC_BUDGET_CHANGES=false
REQUIRE_APPROVAL_FOR_ALL_WRITES=true
REQUIRE_SECOND_APPROVER_FOR_HIGH_RISK=true
MAX_AUTOMATED_BUDGET_CHANGE_PCT=0

# Shopify Marketing Operations reads. Use the permanent *.myshopify.com domain.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_READ_ONLY=true
SHOPIFY_PRIORITY_LOCATION_IDS=

# Google shared OAuth. GOOGLE_OAUTH_ACCESS_TOKEN is a local connection-test aid;
# production workers should refresh access server-side from securely stored OAuth
# credentials or an approved service account where the product supports it.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_ACCESS_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Google Analytics 4 Data API v1
GA4_PROPERTY_ID=
GA4_READ_ONLY=true

# Search Console API v1
GSC_SITE_URL=sc-domain:thehula.com
GSC_READ_ONLY=true

# Google Ads API v25 (read-only shell in this release)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25
GOOGLE_ADS_READ_ONLY=true

# Google Business Profile (read-only shell)
GBP_ACCOUNT_ID=
GBP_LOCATION_IDS=
GBP_READ_ONLY=true

# Merchant API v1 (v1beta is retired)
MERCHANT_CENTER_ACCOUNT_ID=
MERCHANT_READ_ONLY=true

# PageSpeed Insights v5
PAGESPEED_API_KEY=
PAGESPEED_STRATEGIES=mobile,desktop

# Meta Marketing API v26.0 (read-only shell)
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_ACCESS_TOKEN=
META_BUSINESS_ID=
META_AD_ACCOUNT_ID=act_
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
META_PIXEL_ID=
META_CATALOG_ID=
META_API_VERSION=v26.0
META_READ_ONLY=true

# Klaviyo stable revision. Beta campaign revisions are deliberately not used.
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_PUBLIC_SITE_ID=
KLAVIYO_ACCOUNT_ID=
KLAVIYO_API_REVISION=2026-01-15
KLAVIYO_READ_ONLY=true

# Controlled crawler — execution belongs in a worker, not Streamlit.
CRAWLER_BASE_URL=https://thehula.com
CRAWLER_USER_AGENT=HULA-Marketing-Ops/1.0
CRAWLER_MAX_PAGES=1000
CRAWLER_REQUESTS_PER_SECOND=1
CRAWLER_TIMEOUT_SECONDS=20
CRAWLER_RESPECT_ROBOTS=true
CRAWLER_ALLOW_PATTERNS=
CRAWLER_DENY_PATTERNS=/cart,/checkout,/account

# Durable job worker
JOB_WORKER_ENABLED=true
JOB_POLL_SECONDS=10
JOB_LEASE_SECONDS=900
JOB_MAX_RETRIES=5

# AI/privacy controls for later grounded drafting calls
AI_DAILY_COST_LIMIT_HKD=
AI_PII_REDACTION_ENABLED=true

# Observability; optional and server-side only
SENTRY_DSN=
SLACK_WEBHOOK_URL=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
